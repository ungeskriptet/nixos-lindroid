From 251752acf24beab2c4ff0d305d3cfa80bf861b90 Mon Sep 17 00:00:00 2001
From: David Wronek <david.wronek@mainlining.org>
Date: Tue, 10 Feb 2026 22:20:08 +0100
Subject: [PATCH] Improve support for other distros

CMake:
- Use CMake to install the required files
- Use pkg-config to discover android-headers

systemd service:
- Let CMake fill in the ExecStart= path
- WantedBy should generally always be a target, so let's use
  `graphical.target`
- Use DynamicUser= instead of hardcoding a user

Signed-off-by: David Wronek <david.wronek@mainlining.org>
---
 CMakeLists.txt                                | 10 +++++++---
 create-disp.service => create-disp.service.in |  6 +++---
 debian/install                                |  2 --
 3 files changed, 10 insertions(+), 8 deletions(-)
 rename create-disp.service => create-disp.service.in (80%)
 delete mode 100644 debian/install

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 69ba555..82bf73c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -13,16 +13,16 @@ add_compile_options(-Werror)
 add_executable(create-disp create-disp_buffers.cpp  create-disp_core.cpp  create-disp_display.cpp  create-disp_threads.cpp  main.cpp)
 
 find_package(PkgConfig REQUIRED)
+pkg_check_modules(ANDROID_HEADERS REQUIRED android-headers)
 pkg_check_modules(LIBDRM REQUIRED libdrm)
 pkg_check_modules(SYSTEMD REQUIRED libsystemd)
 
-include_directories(${LIBDRM_INCLUDE_DIRS})
 link_directories(${LIBDRM_LIBRARY_DIRS})
 
 target_include_directories(create-disp PRIVATE
+    ${ANDROID_HEADERS_INCLUDE_DIRS}
+    ${LIBDRM_INCLUDE_DIRS}
     ${SYSTEMD_INCLUDE_DIRS}
-    /usr/include/libdrm
-    /usr/include/android
 )
 
 if(TARGET_USES_REAL_HWC)
@@ -38,3 +38,7 @@ target_link_libraries(create-disp
     ${LIBDRM_LIBRARIES}
     ${SYSTEMD_LIBRARIES}
 )
+
+configure_file(create-disp.service.in create-disp.service)
+install(TARGETS create-disp DESTINATION bin)
+install(FILES ${CMAKE_CURRENT_BINARY_DIR}/create-disp.service DESTINATION lib/systemd/system)
diff --git a/create-disp.service b/create-disp.service.in
similarity index 80%
rename from create-disp.service
rename to create-disp.service.in
index dc19825..f59c52f 100644
--- a/create-disp.service
+++ b/create-disp.service.in
@@ -8,7 +8,7 @@ Type=notify
 NotifyAccess=main
 Restart=always
 RestartSec=1
-User=lindroid
+DynamicUser=true
 LimitRTPRIO=45
 LimitMEMLOCK=infinity
 CPUSchedulingPolicy=fifo
@@ -16,7 +16,7 @@ CPUSchedulingPriority=45
 OOMScoreAdjust=-900
 MemoryDenyWriteExecute=no
 LimitNOFILE=65536
-ExecStart=/usr/bin/create-disp
+ExecStart=@CMAKE_INSTALL_PREFIX@/bin/create-disp
 
 [Install]
-WantedBy=display-manager.service
+WantedBy=graphical.target
diff --git a/debian/install b/debian/install
deleted file mode 100644
index e1774fd..0000000
--- a/debian/install
+++ /dev/null
@@ -1,2 +0,0 @@
-obj-*/create-disp usr/bin
-create-disp.service lib/systemd/system
-- 
2.55.0

